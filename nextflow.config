params {
    mode = ''
    max_cpus = 8
    max_memory = '16 GB'
    enable_gpu = 'false'
    bakta_db_type = 'light'
    results_dir = "${params.output_dir}/Results"
    scripts_dir = "${projectDir}/scripts"
    envs_dir = "${projectDir}/envs"
    db_setup = ''
    db_root = ''
    input_dir = ''
    output_dir = ''
    sample_sheet = ''
    basecaller = ''
    help = ''
    polypolish_args = ''
    force_db_update = ''
    
    c = ''
    m = ''
    d = ''
    i = ''
    o = ''
    s = ''
    b = ''
    h = ''

    max_cpus     = params.c ? params.c : params.max_cpus
    max_memory   = params.m ? params.m : params.max_memory
    db_root      = params.d ? params.d : params.db_root
    input_dir    = params.i ? params.i : params.input_dir
    output_dir   = params.o ? params.o : params.output_dir
    sample_sheet = params.s ? params.s : params.sample_sheet
    basecaller   = params.b ? params.b : params.basecaller
    help         = params.h ? params.h : params.help   

    
}

profiles {
  laptop {
    includeConfig 'conf/laptop.config'
  }
  server {
    includeConfig 'conf/server.config'
  }
}

conda {
  enabled = true
  cacheDir = './.conda_cache'
  useMicromamba = true
}
